{
  "interface": {
    "displayName": "\u661f\u6800\u5199\u4f5c\u63d2\u4ef6",
    "shortDescription": "\u65b0\u4e66\u6784\u5efa\u3001\u7ae0\u7eb2\u8282\u594f\u3001\u6b63\u6587\u5199\u4f5c\u4e0e\u62c6\u4e66\u5b66\u4e60",
    "longDescription": "\u4e2d\u6587\u8fde\u8f7d\u5c0f\u8bf4\u5199\u4f5c\u98ce\u683c\uff1a\u5168\u4e66\u4ee5\u5bf9\u767d\u4f18\u5148\u63a8\u8fdb\u4e3b\u7ebf\uff0c\u6218\u6597\u7a81\u51fa\u52a8\u4f5c\u4e0e\u4eba\u7269\u5f62\u8c61\uff0c\u66a7\u6627\u4ee5\u542b\u84c4\u884c\u52a8\u548c\u56de\u5e94\u63a8\u8fdb\uff0c\u5176\u4ed6\u573a\u666f\u4f9d\u5f53\u524d\u5904\u5883\u8c03\u6574\uff1b\u6309\u672c\u4e66\u4eba\u8bbe\u3001\u9636\u6bb5\u3001\u73af\u5883\u3001\u5173\u7cfb\u548c\u60c5\u7eea\u5339\u914d17\u7c7b\u58f0\u7ebf\u53ca15\u79cd\u60c5\u7eea\u4e0e\u72b6\u6001\u3002\u5bf9\u767d\u628a\u4eba\u7269\u5f53\u4e0b\u7684\u53e3\u6c14\u8bf4\u5b8c\u6574\uff0c\u53d9\u8ff0\u628a\u52a8\u4f5c\u548c\u60c5\u7eea\u63a5\u987a\uff1b\u8fde\u63a5\u8bcd\u3001\u8bed\u6c14\u6210\u5206\u4e0e\u5c0f\u4fee\u9970\u8bcd\u53ef\u6bd4\u6781\u7b80\u8868\u8fbe\u7a0d\u591a\u4e00\u4e9b\uff0c\u53e3\u8bed\u548c\u7f51\u7edc\u8868\u8fbe\u4f9d\u4eba\u7269\u3001\u65f6\u4ee3\u4e0e\u573a\u5408\u9009\u7528\uff0c\u9971\u6ee1\u81ea\u7136\u800c\u4e0d\u91cd\u590d\u7ed5\u8bdd\u3002\u670d\u4ece\u672c\u4e66\u89c6\u89d2\u8bbe\u5b9a\uff0c\u540c\u4e00\u8fde\u7eed\u573a\u666f\u53ea\u76f4\u63a5\u5c55\u5f00\u4e00\u4f4d\u4e3b\u8981\u4eba\u7269\u7684\u5fc3\u7406\uff0c\u5141\u8bb8\u7b26\u5408\u58f0\u7ebf\u7684\u7b2c\u4e00\u4eba\u79f0\u53e3\u8bed\u72ec\u767d\uff1b\u5176\u4ed6\u4eba\u7269\u901a\u8fc7\u89c2\u5bdf\u3001\u5bf9\u767d\u3001\u5fae\u8868\u60c5\u548c\u884c\u52a8\u56de\u5e94\uff0c\u4e0d\u81ea\u52a8\u77e5\u9053\u672a\u8868\u8fbe\u7684\u5ff5\u5934\u3002\u4fdd\u7559\u7559\u767d\uff0c\u7981\u6b62\u66ff\u8bfb\u8005\u603b\u7ed3\u548c\u7ae0\u672b\u5347\u534e\uff1b\u5b8c\u6574\u7ae0\u8282\u6b63\u6587\u4ee53000\u5b57\u4e3a\u76ee\u6807\uff0c\u63a7\u5236\u57282700\u20143300\u5b57\u5e76\u7559\u5177\u4f53\u94a9\u5b50\uff1b\u7ed3\u5408\u4eba\u8bbe\u4e0e\u573a\u666f\u7ec6\u5199\u773c\u795e\u3001\u6cea\u6c34\u3001\u5507\u89d2\u548c\u5fae\u8868\u60c5\uff0c\u5141\u8bb8\u8d34\u5408\u8bed\u5883\u7684\u5f62\u5bb9\u4e0e\u6bd4\u55bb\uff0c\u907f\u514d\u56fa\u5b9a\u53cd\u5e94\u4e0e\u8bfb\u5fc3\uff1b\u51cf\u5c11\u91cd\u590d\u7528\u8bcd\u3001\u6a21\u677f\u53e5\u5f0f\u548c\u65e0\u610f\u4e49\u6838\u5bf9\uff0c\u4fdd\u7559\u4f0f\u7b14\u56de\u54cd\u4e0e\u65e2\u6709\u8d44\u6599\u8bfb\u53d6\u89c4\u5219\u3002\u5199\u4f5c\u6280\u80fd\u4e0d\u5305\u542b\u4fdd\u5b58\u6d41\u7a0b\u6216\u68c0\u67e5\u6a21\u5757\u3002\u53e6\u63d0\u4f9b\u72ec\u7acb\u7684\u6587\u7ae0\u62c6\u89e3\u4e0e\u5199\u6cd5\u5b66\u4e60\u6280\u80fd\uff0c\u652f\u6301\u201c\u5e2e\u6211\u62c6\u89e3\u201d\u53ca\u62c6\u4e66\u3001\u5206\u6790\u6587\u98ce\u7b49\u610f\u56fe\uff1b\u6309\u5b9e\u9645\u539f\u6587\u62c6\u5f00\u7bc7\u524d\u4e09\u7ae0\u3001\u4eba\u8bbe\u4e0e\u7fa4\u50cf\u3001\u6bcf\u7ae0\u8282\u594f\u548c\u723d\u70b9\u5347\u7ea7\u3001\u538b\u6291\u81f3\u7206\u53d1\u4e0e\u6536\u5c3e\u95ed\u73af\u3001\u9636\u6bb5\u7ed3\u6784\u53ca\u53cd\u8f6c\u548c\u4e3b\u7ebf\u4f0f\u7b14\u56de\u6536\uff0c\u540c\u65f6\u6df1\u62c6\u6587\u98ce\u683c\u5f0f\uff0c\u4e3e\u4e00\u53cd\u4e09\u5f62\u6210\u539f\u521b\u8111\u6d1e\u4e0e\u5267\u60c5\u53d8\u5316\u3002\u660e\u786e\u5df2\u8bfb\u8303\u56f4\u4e0e\u7ae0\u6b21\u4f9d\u636e\uff0c\u4e0d\u628a\u5c40\u90e8\u6837\u672c\u5f53\u6210\u5168\u4e66\u89c4\u5f8b\u3002\u5b66\u4e60\u6210\u679c\u5206\u4e3a\u901a\u7528\u65b9\u6cd5\u5019\u9009\u3001\u7279\u5b9a\u98ce\u683c\u4e0e\u573a\u666f\u6280\u5de7\u3001\u5f85\u9a8c\u8bc1\u53d1\u73b0\uff0c\u5bf9\u7167\u73b0\u6709\u89c4\u5219\u5e76\u5448\u73b0\u76f4\u63a5\u8bf4\u660e\u3001\u539f\u521b\u8bd5\u5199\u548c\u5177\u4f53\u8c03\u6574\u63d0\u6848\uff0c\u5f97\u5230\u672c\u4eba\u660e\u786e\u540c\u610f\u540e\u624d\u6309\u83b7\u51c6\u8303\u56f4\u66f4\u65b0\u6b63\u5f0f\u89c4\u5219\u3002\u65b0\u589e\u201c\u6784\u5efa\u5168\u65b0\u5c0f\u8bf4\u201d\u6280\u80fd\uff0c\u7528\u201c\u6784\u5efa\u5168\u65b0\u5c0f\u8bf4\u201d\u6216\u201c\u5e2e\u6211\u521b\u5efa\u4e00\u672c\u65b0\u5c0f\u8bf4\u201d\u542f\u52a8\uff0c\u6309\u9898\u6750\u3001\u53ef\u8df3\u8fc7\u7684\u4e66\u540d\u3001\u6545\u4e8b\u80cc\u666f\u4e0e\u4e16\u754c\u89c2\u3001\u4e3b\u8981\u4eba\u7269\u3001\u53ef\u9009\u91d1\u624b\u6307\u53ca\u89c4\u5219\uff0c\u9010\u8f6e\u5f62\u6210\u6545\u4e8b\u6846\u67b6\u3001\u5168\u4e66\u5927\u7eb2\u3001\u5377\u7eb2\u3001\u7ae0\u7eb2\u4e0e\u7ec6\u7eb2\u3002\u7ae0\u7eb2\u4e0e\u8282\u594f\u5df2\u5b8c\u6574\u5408\u5e76\uff0c\u539f\u6709\u7ae0\u7eb2\u542f\u52a8\u8bcd\u76f4\u63a5\u8fdb\u5165\u201c\u6784\u5efa\u5168\u65b0\u5c0f\u8bf4\u201d\u7684\u5bf9\u5e94\u89c4\u5212\u6a21\u5f0f\u3002\u6bcf\u8f6e\u4e00\u4e2a\u5173\u952e\u95ee\u9898\uff0c\u63a5\u7eb3\u81ea\u7531\u56de\u7b54\u548c\u989d\u5916\u8865\u5145\uff0c\u590d\u7528\u5df2\u77e5\u4fe1\u606f\uff1b\u652f\u6301\u76f4\u63a5\u642d\u5efa\u3001\u6682\u5b9a\u8349\u6848\u3001\u5c40\u90e8\u4fee\u8ba2\u53ca\u6309\u5c42\u7ea7\u6574\u7406\u3002\u53ef\u8054\u52a8\u62c6\u4e66\u5206\u6790\u540c\u7c7b\u4f5c\u54c1\uff0c\u6309\u9700\u8054\u7f51\u6838\u5b9e\u516c\u5f00\u8d44\u6599\uff0c\u6ce8\u660e\u5b9e\u9645\u9605\u8bfb\u8303\u56f4\u5e76\u63d0\u4f9b\u53ef\u6bd4\u8f83\u7684\u539f\u521b\u65b9\u5411\u3002\u5b89\u6392\u4e8b\u4ef6\u3001\u4fe1\u606f\u3001\u60c5\u7eea\u4e0e\u56de\u62a5\u8282\u594f\u3001\u8de8\u7ae0\u627f\u63a5\u548c\u7bc7\u5e45\u4e3b\u6b21\u3002\u62c6\u4e66\u6280\u80fd\u53e6\u652f\u6301\u53c2\u8003\u5199\u6cd5\u793a\u8303\uff1a\u5b8c\u5168\u4f9d\u636e\u5b9e\u9645\u8bfb\u5230\u7684\u6307\u5b9a\u6587\u7ae0\u6216\u7ae0\u6bb5\u7684\u6587\u98ce\u3001\u89c6\u89d2\u3001\u53e5\u5f0f\u3001\u5bf9\u767d\u7ec4\u7ec7\u3001\u5206\u6bb5\u3001\u6807\u70b9\u53ca\u6536\u675f\u5199\u539f\u521b\u4f8b\u6587\uff0c\u4e0d\u5f3a\u5957\u661f\u6800\u6b63\u6587\u9ed8\u8ba4\u98ce\u683c\u548c\u7ae0\u957f\uff1b\u5148\u5b8c\u6574\u4f8b\u6587\uff0c\u518d\u5bf9\u5e94\u539f\u6587\u4e0e\u4f8b\u6587\u89e3\u91ca\u5177\u4f53\u5199\u4f5c\u65b9\u6cd5\u548c\u683c\u5f0f\u3002\u661f\u6800\u9002\u914d\u8bd5\u5199\u53e6\u884c\u4fdd\u7559\uff0c\u4e34\u65f6\u793a\u8303\u4e0d\u81ea\u52a8\u6210\u4e3a\u6b63\u5f0f\u89c4\u5219\u6216\u672c\u4eba\u5c0f\u8bf4\u4e8b\u5b9e\u3002\u7ae0\u7eb2\u4e0e\u8282\u594f\u652f\u6301\u201c\u5e2e\u6211\u8bbe\u8ba1\u7ae0\u7eb2\u201d\u542f\u52a8\u3001\u201c\u76f4\u63a5\u751f\u6210\u7ae0\u7eb2\u201d\u4f9d\u636e\u5df2\u6709\u8d44\u6599\u8f93\u51fa\uff0c\u4ee5\u53ca\u201c\u5148\u966a\u6211\u6784\u601d\u201d\u9010\u8f6e\u63d0\u95ee\uff1b\u6bcf\u4e2a\u95ee\u9898\u63a5\u7eb3\u81ea\u7531\u56de\u7b54\u548c\u989d\u5916\u8865\u5145\uff0c\u6309\u56de\u7b54\u6301\u7eed\u8c03\u6574\u7c97\u7565\u6784\u601d\uff0c\u63d0\u95ee\u6846\u53ef\u7528\u65f6\u4f18\u5148\u4f7f\u7528\uff0c\u4e0d\u9002\u7528\u65f6\u7528\u666e\u901a\u5bf9\u8bdd\uff0c\u6309\u8981\u6c42\u6574\u7406\u6b63\u5f0f\u7ae0\u7eb2\u3002",
    "developerName": "Workspace upload",
    "category": "Other",
    "capabilities": [],
    "defaultPrompt": [
      "\u5e2e\u6211\u62c6\u89e3",
      "\u5e2e\u6211\u521b\u5efa\u4e00\u672c\u65b0\u5c0f\u8bf4"
    ]
  },
  "name": "write-serial-fiction",
  "version": "2.0.2",
  "description": "\u4e2d\u6587\u8fde\u8f7d\u5c0f\u8bf4\u5199\u4f5c\u98ce\u683c\uff1a\u5168\u4e66\u4ee5\u5bf9\u767d\u4f18\u5148\u63a8\u8fdb\u4e3b\u7ebf\uff0c\u6218\u6597\u7a81\u51fa\u52a8\u4f5c\u4e0e\u4eba\u7269\u5f62\u8c61\uff0c\u66a7\u6627\u4ee5\u542b\u84c4\u884c\u52a8\u548c\u56de\u5e94\u63a8\u8fdb\uff0c\u5176\u4ed6\u573a\u666f\u4f9d\u5f53\u524d\u5904\u5883\u8c03\u6574\uff1b\u6309\u672c\u4e66\u4eba\u8bbe\u3001\u9636\u6bb5\u3001\u73af\u5883\u3001\u5173\u7cfb\u548c\u60c5\u7eea\u5339\u914d17\u7c7b\u58f0\u7ebf\u53ca15\u79cd\u60c5\u7eea\u4e0e\u72b6\u6001\u3002\u5bf9\u767d\u628a\u4eba\u7269\u5f53\u4e0b\u7684\u53e3\u6c14\u8bf4\u5b8c\u6574\uff0c\u53d9\u8ff0\u628a\u52a8\u4f5c\u548c\u60c5\u7eea\u63a5\u987a\uff1b\u8fde\u63a5\u8bcd\u3001\u8bed\u6c14\u6210\u5206\u4e0e\u5c0f\u4fee\u9970\u8bcd\u53ef\u6bd4\u6781\u7b80\u8868\u8fbe\u7a0d\u591a\u4e00\u4e9b\uff0c\u53e3\u8bed\u548c\u7f51\u7edc\u8868\u8fbe\u4f9d\u4eba\u7269\u3001\u65f6\u4ee3\u4e0e\u573a\u5408\u9009\u7528\uff0c\u9971\u6ee1\u81ea\u7136\u800c\u4e0d\u91cd\u590d\u7ed5\u8bdd\u3002\u670d\u4ece\u672c\u4e66\u89c6\u89d2\u8bbe\u5b9a\uff0c\u540c\u4e00\u8fde\u7eed\u573a\u666f\u53ea\u76f4\u63a5\u5c55\u5f00\u4e00\u4f4d\u4e3b\u8981\u4eba\u7269\u7684\u5fc3\u7406\uff0c\u5141\u8bb8\u7b26\u5408\u58f0\u7ebf\u7684\u7b2c\u4e00\u4eba\u79f0\u53e3\u8bed\u72ec\u767d\uff1b\u5176\u4ed6\u4eba\u7269\u901a\u8fc7\u89c2\u5bdf\u3001\u5bf9\u767d\u3001\u5fae\u8868\u60c5\u548c\u884c\u52a8\u56de\u5e94\uff0c\u4e0d\u81ea\u52a8\u77e5\u9053\u672a\u8868\u8fbe\u7684\u5ff5\u5934\u3002\u4fdd\u7559\u7559\u767d\uff0c\u7981\u6b62\u66ff\u8bfb\u8005\u603b\u7ed3\u548c\u7ae0\u672b\u5347\u534e\uff1b\u5b8c\u6574\u7ae0\u8282\u6b63\u6587\u4ee53000\u5b57\u4e3a\u76ee\u6807\uff0c\u63a7\u5236\u57282700\u20143300\u5b57\u5e76\u7559\u5177\u4f53\u94a9\u5b50\uff1b\u7ed3\u5408\u4eba\u8bbe\u4e0e\u573a\u666f\u7ec6\u5199\u773c\u795e\u3001\u6cea\u6c34\u3001\u5507\u89d2\u548c\u5fae\u8868\u60c5\uff0c\u5141\u8bb8\u8d34\u5408\u8bed\u5883\u7684\u5f62\u5bb9\u4e0e\u6bd4\u55bb\uff0c\u907f\u514d\u56fa\u5b9a\u53cd\u5e94\u4e0e\u8bfb\u5fc3\uff1b\u51cf\u5c11\u91cd\u590d\u7528\u8bcd\u3001\u6a21\u677f\u53e5\u5f0f\u548c\u65e0\u610f\u4e49\u6838\u5bf9\uff0c\u4fdd\u7559\u4f0f\u7b14\u56de\u54cd\u4e0e\u65e2\u6709\u8d44\u6599\u8bfb\u53d6\u89c4\u5219\u3002\u5199\u4f5c\u6280\u80fd\u4e0d\u5305\u542b\u4fdd\u5b58\u6d41\u7a0b\u6216\u68c0\u67e5\u6a21\u5757\u3002\u53e6\u63d0\u4f9b\u72ec\u7acb\u7684\u6587\u7ae0\u62c6\u89e3\u4e0e\u5199\u6cd5\u5b66\u4e60\u6280\u80fd\uff0c\u652f\u6301\u201c\u5e2e\u6211\u62c6\u89e3\u201d\u53ca\u62c6\u4e66\u3001\u5206\u6790\u6587\u98ce\u7b49\u610f\u56fe\uff1b\u6309\u5b9e\u9645\u539f\u6587\u62c6\u5f00\u7bc7\u524d\u4e09\u7ae0\u3001\u4eba\u8bbe\u4e0e\u7fa4\u50cf\u3001\u6bcf\u7ae0\u8282\u594f\u548c\u723d\u70b9\u5347\u7ea7\u3001\u538b\u6291\u81f3\u7206\u53d1\u4e0e\u6536\u5c3e\u95ed\u73af\u3001\u9636\u6bb5\u7ed3\u6784\u53ca\u53cd\u8f6c\u548c\u4e3b\u7ebf\u4f0f\u7b14\u56de\u6536\uff0c\u540c\u65f6\u6df1\u62c6\u6587\u98ce\u683c\u5f0f\uff0c\u4e3e\u4e00\u53cd\u4e09\u5f62\u6210\u539f\u521b\u8111\u6d1e\u4e0e\u5267\u60c5\u53d8\u5316\u3002\u660e\u786e\u5df2\u8bfb\u8303\u56f4\u4e0e\u7ae0\u6b21\u4f9d\u636e\uff0c\u4e0d\u628a\u5c40\u90e8\u6837\u672c\u5f53\u6210\u5168\u4e66\u89c4\u5f8b\u3002\u5b66\u4e60\u6210\u679c\u5206\u4e3a\u901a\u7528\u65b9\u6cd5\u5019\u9009\u3001\u7279\u5b9a\u98ce\u683c\u4e0e\u573a\u666f\u6280\u5de7\u3001\u5f85\u9a8c\u8bc1\u53d1\u73b0\uff0c\u5bf9\u7167\u73b0\u6709\u89c4\u5219\u5e76\u5448\u73b0\u76f4\u63a5\u8bf4\u660e\u3001\u539f\u521b\u8bd5\u5199\u548c\u5177\u4f53\u8c03\u6574\u63d0\u6848\uff0c\u5f97\u5230\u672c\u4eba\u660e\u786e\u540c\u610f\u540e\u624d\u6309\u83b7\u51c6\u8303\u56f4\u66f4\u65b0\u6b63\u5f0f\u89c4\u5219\u3002\u65b0\u589e\u201c\u6784\u5efa\u5168\u65b0\u5c0f\u8bf4\u201d\u6280\u80fd\uff0c\u7528\u201c\u6784\u5efa\u5168\u65b0\u5c0f\u8bf4\u201d\u6216\u201c\u5e2e\u6211\u521b\u5efa\u4e00\u672c\u65b0\u5c0f\u8bf4\u201d\u542f\u52a8\uff0c\u6309\u9898\u6750\u3001\u53ef\u8df3\u8fc7\u7684\u4e66\u540d\u3001\u6545\u4e8b\u80cc\u666f\u4e0e\u4e16\u754c\u89c2\u3001\u4e3b\u8981\u4eba\u7269\u3001\u53ef\u9009\u91d1\u624b\u6307\u53ca\u89c4\u5219\uff0c\u9010\u8f6e\u5f62\u6210\u6545\u4e8b\u6846\u67b6\u3001\u5168\u4e66\u5927\u7eb2\u3001\u5377\u7eb2\u3001\u7ae0\u7eb2\u4e0e\u7ec6\u7eb2\u3002\u7ae0\u7eb2\u4e0e\u8282\u594f\u5df2\u5b8c\u6574\u5408\u5e76\uff0c\u539f\u6709\u7ae0\u7eb2\u542f\u52a8\u8bcd\u76f4\u63a5\u8fdb\u5165\u201c\u6784\u5efa\u5168\u65b0\u5c0f\u8bf4\u201d\u7684\u5bf9\u5e94\u89c4\u5212\u6a21\u5f0f\u3002\u6bcf\u8f6e\u4e00\u4e2a\u5173\u952e\u95ee\u9898\uff0c\u63a5\u7eb3\u81ea\u7531\u56de\u7b54\u548c\u989d\u5916\u8865\u5145\uff0c\u590d\u7528\u5df2\u77e5\u4fe1\u606f\uff1b\u652f\u6301\u76f4\u63a5\u642d\u5efa\u3001\u6682\u5b9a\u8349\u6848\u3001\u5c40\u90e8\u4fee\u8ba2\u53ca\u6309\u5c42\u7ea7\u6574\u7406\u3002\u53ef\u8054\u52a8\u62c6\u4e66\u5206\u6790\u540c\u7c7b\u4f5c\u54c1\uff0c\u6309\u9700\u8054\u7f51\u6838\u5b9e\u516c\u5f00\u8d44\u6599\uff0c\u6ce8\u660e\u5b9e\u9645\u9605\u8bfb\u8303\u56f4\u5e76\u63d0\u4f9b\u53ef\u6bd4\u8f83\u7684\u539f\u521b\u65b9\u5411\u3002\u5b89\u6392\u4e8b\u4ef6\u3001\u4fe1\u606f\u3001\u60c5\u7eea\u4e0e\u56de\u62a5\u8282\u594f\u3001\u8de8\u7ae0\u627f\u63a5\u548c\u7bc7\u5e45\u4e3b\u6b21\u3002\u62c6\u4e66\u6280\u80fd\u53e6\u652f\u6301\u53c2\u8003\u5199\u6cd5\u793a\u8303\uff1a\u5b8c\u5168\u4f9d\u636e\u5b9e\u9645\u8bfb\u5230\u7684\u6307\u5b9a\u6587\u7ae0\u6216\u7ae0\u6bb5\u7684\u6587\u98ce\u3001\u89c6\u89d2\u3001\u53e5\u5f0f\u3001\u5bf9\u767d\u7ec4\u7ec7\u3001\u5206\u6bb5\u3001\u6807\u70b9\u53ca\u6536\u675f\u5199\u539f\u521b\u4f8b\u6587\uff0c\u4e0d\u5f3a\u5957\u661f\u6800\u6b63\u6587\u9ed8\u8ba4\u98ce\u683c\u548c\u7ae0\u957f\uff1b\u5148\u5b8c\u6574\u4f8b\u6587\uff0c\u518d\u5bf9\u5e94\u539f\u6587\u4e0e\u4f8b\u6587\u89e3\u91ca\u5177\u4f53\u5199\u4f5c\u65b9\u6cd5\u548c\u683c\u5f0f\u3002\u661f\u6800\u9002\u914d\u8bd5\u5199\u53e6\u884c\u4fdd\u7559\uff0c\u4e34\u65f6\u793a\u8303\u4e0d\u81ea\u52a8\u6210\u4e3a\u6b63\u5f0f\u89c4\u5219\u6216\u672c\u4eba\u5c0f\u8bf4\u4e8b\u5b9e\u3002\u7ae0\u7eb2\u4e0e\u8282\u594f\u652f\u6301\u201c\u5e2e\u6211\u8bbe\u8ba1\u7ae0\u7eb2\u201d\u542f\u52a8\u3001\u201c\u76f4\u63a5\u751f\u6210\u7ae0\u7eb2\u201d\u4f9d\u636e\u5df2\u6709\u8d44\u6599\u8f93\u51fa\uff0c\u4ee5\u53ca\u201c\u5148\u966a\u6211\u6784\u601d\u201d\u9010\u8f6e\u63d0\u95ee\uff1b\u6bcf\u4e2a\u95ee\u9898\u63a5\u7eb3\u81ea\u7531\u56de\u7b54\u548c\u989d\u5916\u8865\u5145\uff0c\u6309\u56de\u7b54\u6301\u7eed\u8c03\u6574\u7c97\u7565\u6784\u601d\uff0c\u63d0\u95ee\u6846\u53ef\u7528\u65f6\u4f18\u5148\u4f7f\u7528\uff0c\u4e0d\u9002\u7528\u65f6\u7528\u666e\u901a\u5bf9\u8bdd\uff0c\u6309\u8981\u6c42\u6574\u7406\u6b63\u5f0f\u7ae0\u7eb2\u3002",
